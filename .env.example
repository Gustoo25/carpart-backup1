# Stripe API keys — get these from https://dashboard.stripe.com/apikeys
# Use TEST keys (sk_test_..., pk_test_...) until you're ready to take real payments.
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Public URL of your site (used for Stripe success/cancel redirects)
# In dev: http://localhost:3000
# In prod: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
